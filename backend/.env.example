# Base de datos
DATABASE_URL=mysql+pymysql://usuario:password@host:3306/servicios_bogota

# JWT
SECRET_KEY=cambia_esto_por_una_clave_segura_de_64_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Wompi (pagos Colombia)
WOMPI_PUBLIC_KEY=pub_test_xxxx
WOMPI_PRIVATE_KEY=prv_test_xxxx
WOMPI_EVENTS_SECRET=xxxx
WOMPI_BASE_URL=https://sandbox.wompi.co/v1

# Cloudinary (fotos de negocios)
CLOUDINARY_CLOUD_NAME=tu_cloud
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# App
APP_NAME=ServiciosBogotá
APP_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
